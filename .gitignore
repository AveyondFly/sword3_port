# 构建产物（引擎二进制，由 build_docker.sh 生成，不入库；CI 产物经 artifact 分发）
sword3
libbionic_shim.so
liblog.so
build/
deploy/
dist/

# 游戏自带 Android .so：随包、需 LIBC->WEAK patch，由本地提供并【入库】（置于 libs/）。
# 根目录的引擎 shim（libbionic_shim.so/liblog.so）已由上方显式忽略；
# 全局 *.so 用于挡住其它散落 .so，再用 !libs/*.so 放行 libs/ 下的游戏 .so。
*.so
!libs/
!libs/*.so

# 游戏资源（assets/：音乐/视频/贴图等大体量数据，BYO-data，不入库）
assets/

# 设备运行日志（临时，不入库；手动跑游戏会存回本目录）
log.txt
debug.log
*.log

# 误用脚手架反例（不应入库；原 PROGRESS/HANDOFF 称其已 git-ignored，实际未被忽略）
src/_unused_katanazero/

# 游戏 .so 备份（BYO-data，不入库）
libs/*.bak-*

# WorkBuddy 本地工作目录（含 memory/ 等，仅本地辅助数据，不入库不推送）
.workbuddy/
